{
  // 纯静态站点：scripts/build-site.sh 生成 site/，部署到 games.wayai.cc
  "name": "aircade",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "games.wayai.cc", "custom_domain": true }],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
