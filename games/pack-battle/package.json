{
  "name": "pack-battle",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "description": "行囊对决 PACK BATTLE — 俄罗斯方块 × 背包整理 × 自动战斗",
  "scripts": {
    "dev": "vite --port 5104 --strictPort --host",
    "build": "tsc --noEmit && vite build",
    "build:tap": "tsc --noEmit && vite build --mode tap --outDir dist-tap && node scripts/pack-tap.ts",
    "build:yoola": "tsc --noEmit && node scripts/pack-yoola.ts && node scripts/yoola/smoke.mjs",
    "audio:yoola": "node scripts/yoola/audio.ts",
    "preview": "vite preview --port 5104 --strictPort --host",
    "balance": "node scripts/balance.ts",
    "bot": "node scripts/bot.ts",
    "ad-rules": "node scripts/ad-rules.ts",
    "icons": "node scripts/icons.ts",
    "trailer:shoot": "node scripts/trailer/shoot.ts",
    "trailer:captions": "node scripts/trailer/captions.ts",
    "trailer:edit": "node scripts/trailer/edit.ts && node scripts/trailer/edit.ts --nocap",
    "trailer:cover": "node scripts/trailer/shoot.ts cover34 && node scripts/trailer/cover.ts",
    "trailer": "pnpm trailer:shoot && pnpm trailer:captions && pnpm trailer:edit && node scripts/trailer/cover.ts"
  },
  "dependencies": {
    "@fontsource/kalam": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0"
  },
  "devDependencies": {
    "@fontsource/ma-shan-zheng": "5.3.1",
    "@types/node": "~24.19.2",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "~8.3.4"
  },
  "packageManager": "pnpm@11.8.0"
}
